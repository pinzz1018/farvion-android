{
  "appId": "id.my.farvion",
  "appName": "Farvion",
  "webDir": "www",
  "server": {
    "url": "https://farvion.my.id",
    "cleartext": false,
    "allowNavigation": ["farvion.my.id", "*.farvion.my.id"]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FAF9F5"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
