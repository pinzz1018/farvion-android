{
  "appId": "id.my.farvion",
  "appName": "Farvion",
  "webDir": "www",
  "server": {
    "url": "https://farvion.my.id/chat",
    "cleartext": false,
    "allowNavigation": [
      "farvion.my.id",
      "*.farvion.my.id"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FDFBF7"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 4000,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#FDFBF7",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
